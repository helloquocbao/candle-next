# Binance
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

# Cặp coin & khung nến. Ưu tiên theo thứ tự (xem apps/ingestion-service/README.md,
# apps/prediction-engine/README.md): SYMBOL_PAIRS/TRACKED_PAIRS (override thủ
# công, ví dụ "BTCUSDT:1m,ETHUSDT:1m") -> bảng tracked_pairs trong DB
# (infra/db/migrations/002_tracked_pairs.sql) -> SYMBOL/INTERVAL đơn lẻ (fallback).
SYMBOL=BTCUSDT
INTERVAL=1m
# SYMBOL_PAIRS=BTCUSDT:1m,ETHUSDT:1m,SOLUSDT:1m   # ingestion-service
# TRACKED_PAIRS=BTCUSDT:1m,ETHUSDT:1m,SOLUSDT:1m  # prediction-engine
BOOTSTRAP_LIMIT=500

# Nguồn sàn (exchange) cho ingestion-service. Hỗ trợ: binance | okx | bybit.
# Symbol/interval luôn giữ chuẩn Binance (BTCUSDT/1m), adapter tự convert sang
# format riêng của sàn (OKX: BTC-USDT, 1H; Bybit: 1/60/240...). Chọn theo thứ tự:
#   1. Segment thứ 3 trong SYMBOL_PAIRS, vd "BTCUSDT:1m:okx,ETHUSDT:5m:bybit"
#   2. Biến EXCHANGE bên dưới (áp dụng cho các cặp không ghi rõ sàn)
#   3. Mặc định "binance"
# Lưu ý: một cặp chỉ lấy từ MỘT sàn (chạy cùng symbol trên nhiều sàn song song
# cần đưa exchange vào khoá DB/Redis — xem ghi chú follow-up trong code).
# EXCHANGE=binance
# BYBIT_CATEGORY=spot   # spot | linear (USDT perpetual) | inverse

# Database — docker-compose.yml đọc trực tiếp 3 biến này để khởi tạo Postgres,
# và DATABASE_URL bên dưới PHẢI dùng đúng user/pass/db đã set ở đây.
# BẮT BUỘC đổi sang giá trị mạnh, ngẫu nhiên khi deploy production
# (vd: openssl rand -base64 24). Không dùng giá trị mẫu này thật.
POSTGRES_DB=crypto_predictor
POSTGRES_USER=change_me_user
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://change_me_user:change_me_strong_password@timescaledb:5432/crypto_predictor

# Redis — BẮT BUỘC set password mạnh cho production, Redis không auth theo
# mặc định. docker-compose.yml sẽ start Redis với --requirepass "$REDIS_PASSWORD".
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379

# Môi trường & logging
NODE_ENV=production
LOG_LEVEL=info

# Prediction Engine — vong lap self-learning (Genetic Algorithm), xem
# apps/prediction-engine/README.md. Bo qua cac dong nay de dung gia tri
# mac dinh (30 / 80 / 0.7 / 200).
# OPTIMIZE_EVERY_N_EVALUATIONS=30
# MIN_HISTORY_FOR_OPTIMIZE=80
# TRAIN_SPLIT_RATIO=0.7
# ACCURACY_HISTORY_MAXLEN=200
# CANDLE_BUFFER_MAXLEN=200

# Ensemble AI (DeepSeek) — tin hieu BO SUNG ket hop voi baseline/LightGBM+GA
# (crypto, apps/prediction-engine) va drift EMA+ATR (HOSE,
# apps/prediction-engine-hose), KHONG thay the. Dung chung 1 bo bien moi
# truong cho ca 2 service (moi service tu doc, co the bat/tat rieng qua
# docker-compose.yml neu can). Mac dinh TAT (an toan, khong doi hanh vi hien
# co) — chi bat khi da co API key that va hieu ro trade-off do tre/chi phi
# (xem apps/prediction-engine/README.md muc "Ensemble AI (DeepSeek)").
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SEC=8
# Trong so gia AI trong blend (0..1) — phan con lai la trong so model dinh luong.
DEEPSEEK_WEIGHT=0.35
# He so nhan (phat) confidence khi AI va model dinh luong bat dong chieu.
DEEPSEEK_DISAGREEMENT_PENALTY=0.5
# CHI danh cho prediction-engine (crypto) — so nen dong giua 2 lan goi AI.
# Voi interval ngan (1m) NEN tang len (vd 10-15) de gioi han chi phi/rate
# limit; voi interval dai (1h/1d) de 1 (goi moi nen) van re. HOSE (EOD, mac
# dinh 1 lan/gio) KHONG can bien nay — luon goi moi chu ky, da du re.
# AI_REFRESH_EVERY_N_CANDLES=3

# API Gateway
API_PORT=8080
# Frontend deploy trên Vercel (domain khác backend) -> BẮT BUỘC liệt kê đúng
# domain Vercel ở đây, nếu không trình duyệt sẽ chặn request (CORS).
# Có thể liệt kê nhiều origin, phân cách dấu phẩy, vd:
#   CORS_ORIGIN=https://your-project.vercel.app,http://localhost:5173
# (giữ localhost:5173 để vẫn chạy được frontend dev server cục bộ khi cần)
CORS_ORIGIN=https://your-project.vercel.app,http://localhost:5173

# Monetization (affiliate/ads keys)
BINANCE_REF_ID=
COINZILLA_ZONE_ID=
